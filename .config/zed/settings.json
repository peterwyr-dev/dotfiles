{
    "disable_ai": false,
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "theme": {
        "mode": "dark",
        "light": "Rosé Pine Moon",
        "dark": "Rosé Pine",
    },
    "agent": {
        "dock": "right",
        "default_model": {
            "effort": "high",
            "provider": "zed.dev",
            "model": "claude-sonnet-5",
            "enable_thinking": true,
        },
        "favorite_models": [
            {
                "provider": "zed.dev",
                "model": "claude-sonnet-4-6",
                "enable_thinking": false,
            },
        ],
        "model_parameters": [],
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme",
    },
    "file_finder": {
        "modal_max_width": "large",
    },
    "ui_font_family": "DankMono Nerd Font",
    "ui_font_size": 18,
    "buffer_font_family": "DankMono Nerd Font",
    "buffer_font_size": 18.0,
    "buffer_line_height": {
        "custom": 2,
    },
    "agent_buffer_font_size": 18,
    "vim_mode": true,
    "tab_size": 4,
    "auto_indent": "none",
    "close_on_file_delete": true,
    "restore_on_file_reopen": false,
}
