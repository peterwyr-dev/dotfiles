# =========================================================
# 窗口焦点移动 (Focus Window) - Option + ijkl
# =========================================================
alt - k : yabai -m window --focus north
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - l : yabai -m window --focus east

# =========================================================
# 窗口状态切换 (Toggle Window State)
# =========================================================
# 切换当前窗口浮动/平铺 (Hyper + f)
alt - f : yabai -m window --toggle float
alt - return : open -a Kitty

# =========================================================
# 当前窗口临时布局 (Float Layouts)
# 先确保当前窗口浮动，再按屏幕网格摆位；不影响其他窗口。
# 回到平铺：Hyper + f
# =========================================================
alt - c : yabai -m query --windows --window | jq -e '."is-floating"' >/dev/null || yabai -m window --toggle float; yabai -m query --windows --window | jq -e '."is-topmost"' >/dev/null && yabai -m window --toggle topmost; yabai -m query --windows --window | jq -e '."is-sticky"' >/dev/null && yabai -m window --toggle sticky; yabai -m query --windows --window | jq -e '."is-pip"' >/dev/null && yabai -m window --toggle pip; yabai -m window --grid 24:24:4:0:16:24
alt - a : yabai -m query --windows --window | jq -e '."is-floating"' >/dev/null || yabai -m window --toggle float; yabai -m query --windows --window | jq -e '."is-topmost"' >/dev/null && yabai -m window --toggle topmost; yabai -m query --windows --window | jq -e '."is-sticky"' >/dev/null && yabai -m window --toggle sticky; yabai -m query --windows --window | jq -e '."is-pip"' >/dev/null && yabai -m window --toggle pip; yabai -m window --grid 1:2:0:0:1:1
alt - d : yabai -m query --windows --window | jq -e '."is-floating"' >/dev/null || yabai -m window --toggle float; yabai -m query --windows --window | jq -e '."is-topmost"' >/dev/null && yabai -m window --toggle topmost; yabai -m query --windows --window | jq -e '."is-sticky"' >/dev/null && yabai -m window --toggle sticky; yabai -m query --windows --window | jq -e '."is-pip"' >/dev/null && yabai -m window --toggle pip; yabai -m window --grid 1:2:1:0:1:1

# =========================================================
# 应用启动 (Launch Apps)
# =========================================================
alt - b : open -a "Google Chrome"
alt - u : open -a "Lark"
alt - p : open -a "PDF Expert"
alt - v : open -a "Visual Studio Code"
alt - o : open -a "Obsidian"
alt - t : open -a "Typora"
alt - z : open -a "Clash Verge"
alt - e : open -a "ChatGPT"
alt - w : open -a "WeChat"
# =========================================================
# 桌面焦点切换 (Focus Space)
# =========================================================
# 1. 绝对切换: Hyper + 1-0 (0代表第10个桌面)
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt - 0 : yabai -m space --focus 10

# 2. 相对循环切换: Option + q / w
#cmd + ctrl + alt + shift - q : yabai -m space --focus prev || yabai -m space --focus last
#cmd + ctrl + alt + shift - w : yabai -m space --focus next || yabai -m space --focus first
# alt  - 0x21 : yabai -m space --focus prev || yabai -m space --focus last
# alt  - 0x1E : yabai -m space --focus next || yabai -m space --focus first
alt - 0x21 : yabai -m space --focus prev || yabai -m space --focus last
alt - 0x1E : yabai -m space --focus next || yabai -m space --focus first


