# Gruvbox Hard — dark, warm, and deliberately high contrast
# Palette: https://github.com/morhetz/gruvbox

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1d2021"

# Main text color
theme[main_fg]="#ebdbb2"

# Title color for boxes
theme[title]="#fabd2f"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#fe8019"

# Background color of selected item in processes box
theme[selected_bg]="#3c3836"

# Foreground color of selected item in processes box
theme[selected_fg]="#fabd2f"

# Color of inactive/disabled text
theme[inactive_fg]="#928374"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#d5c4a1"

# Background color of the percentage meters
theme[meter_bg]="#504945"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#b8bb26"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#d79921"
theme[mem_box]="#98971a"
theme[net_box]="#458588"
theme[proc_box]="#b16286"

# Box divider line and small boxes line color
theme[div_line]="#665c54"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#98971a"
theme[temp_mid]="#d79921"
theme[temp_end]="#cc241d"

# CPU graph colors (Aqua -> Blue -> Purple)
theme[cpu_start]="#689d6a"
theme[cpu_mid]="#458588"
theme[cpu_end]="#b16286"

# Mem/Disk free meter (Green -> Aqua -> Blue)
theme[free_start]="#98971a"
theme[free_mid]="#689d6a"
theme[free_end]="#458588"

# Mem/Disk cached meter (Aqua -> Blue)
theme[cached_start]="#689d6a"
theme[cached_mid]="#458588"
theme[cached_end]="#83a598"

# Mem/Disk available meter (Yellow -> Orange -> Red)
theme[available_start]="#d79921"
theme[available_mid]="#d65d0e"
theme[available_end]="#cc241d"

# Mem/Disk used meter (Orange -> Red)
theme[used_start]="#d65d0e"
theme[used_mid]="#cc241d"
theme[used_end]="#fb4934"

# Download graph colors (Blue -> Aqua)
theme[download_start]="#458588"
theme[download_mid]="#689d6a"
theme[download_end]="#8ec07c"

# Upload graph colors (Orange -> Red)
theme[upload_start]="#d65d0e"
theme[upload_mid]="#cc241d"
theme[upload_end]="#fb4934"

# Process box color gradient for threads, mem and cpu usage (Blue -> Purple -> Red)
theme[process_start]="#458588"
theme[process_mid]="#b16286"
theme[process_end]="#cc241d"
