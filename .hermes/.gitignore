# Ignore Hermes runtime state by default; allow only portable configuration.
*
!.gitignore
!config.yaml
!SOUL.md

!skins/
!skins/**

!plugins/
plugins/*
!plugins/herdr-agent-state/
!plugins/herdr-agent-state/plugin.yaml
!plugins/herdr-agent-state/__init__.py

# Skills are portable extensions; exclude Hermes' generated metadata and bytecode.
!skills/
!skills/**
skills/.bundled_manifest
skills/.curator_backups/
skills/.curator_state
skills/.hub/
skills/.usage.json
skills/.usage.json.lock
skills/**/__pycache__/
skills/**/*.pyc
